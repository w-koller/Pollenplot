<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- To download the optional models, and later weed lists and the weather. Photos never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Identify with the camera. Photos are identified on the phone and are not sent anywhere. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Plants can still be added by name or from photos on phones without a camera. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Photo scanning, which the user turns on in Settings. Added photos come through the photo picker instead. -->
    <!-- Approximate location only, for the garden's area: its council's weed list and the plants recorded nearby. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- To say when a scan has found plants. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PollenplotApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pollenplot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="false"
            tools:targetApi="33"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
