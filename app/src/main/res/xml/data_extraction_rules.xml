<?xml version="1.0" encoding="utf-8"?>
<!-- Records and settings only. Photos and the AI models are large; photos are kept in Pollenplot's own backup file. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
